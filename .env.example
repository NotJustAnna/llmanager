# LLManager Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port (default: 3001)
PORT=3001

# Node environment (development or production)
NODE_ENV=development

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT secret for authentication (will auto-generate if not provided)
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Initial admin password (default: admin)
# Change this in production!
AUTH_PASSWORD=admin

# ============================================================================
# DATABASE
# ============================================================================

# Path to SQLite database file (default: llmanager.sqlite)
DB_PATH=llmanager.sqlite

# ============================================================================
# OPENWEBUI CONFIGURATION
# ============================================================================

# OpenWebUI API endpoint (default: http://localhost:3000)
OPENWEBUI_API_URL=http://localhost:3000

# OpenWebUI API key for authentication
# Required to connect to OpenWebUI instance
OPENWEBUI_API_KEY=

# Default model for text generation tasks (default: ollama.gemma3:12b)
OPENWEBUI_DEFAULT_MODEL=ollama.gemma3:12b

# ============================================================================
# OPENROUTER CONFIGURATION
# ============================================================================

# OpenRouter API endpoint (default: https://openrouter.ai/api/v1)
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# OpenRouter API key for authentication
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Ollama API endpoint (default: http://localhost:11434)
# Update if Ollama is running on a different host/port
OLLAMA_API_URL=http://localhost:11434
